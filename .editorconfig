# Editor settings shared by every contributor: https://editorconfig.org
# Ajustes de editor compartilhados por todo contribuidor: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{ts,tsx,json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
