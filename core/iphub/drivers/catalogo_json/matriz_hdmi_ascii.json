{
  "manifesto": {
    "tipo": "matriz_hdmi_ascii",
    "rotulo": {
      "pt": "Matriz HDMI de comando em texto",
      "en": "HDMI matrix with text commands"
    },
    "categoria": "matriz",
    "capacidades": ["ligar", "desligar", "fonte", "comando_extra"],
    "textos": {
      "pt": {
        "descricao": "Matriz HDMI que fala uma linha de texto na porta 23: liga, desliga e escolhe a entrada que vai para a saída 1. Aceita um comando por vez, com 200 ms entre eles."
      },
      "en": {
        "descricao": "HDMI matrix speaking one text line on port 23: power, standby and the input routed to output 1. It takes one command at a time, 200 ms apart."
      }
    }
  },
  "transporte": {
    "tcp": {
      "porta": 23,
      "terminador": "\r\n",
      "timeout_s": 3,
      "intervalo_min_ms": 200
    }
  },
  "comandos": {
    "ligar": {"envia": "SET POWER ON"},
    "desligar": {"envia": "SET POWER OFF"},
    "fonte": {
      "envia": "SET OUT1 VS {valor}",
      "valores": {"HDMI 1": "IN1", "HDMI 2": "IN2", "HDMI 3": "IN3", "HDMI 4": "IN4"}
    },
    "comando_extra": {"envia": "{valor}"}
  },
  "estado": {
    "pede": [{"envia": "GET POWER"}, {"envia": "GET OUT1 VS"}],
    "le": {
      "ligado": {"regex": "POWER (ON|OFF)", "verdadeiro": "ON"},
      "fonte": {"regex": "OUT1 VS (IN[1-8])"}
    }
  }
}
